#!/usr/bin/python3 -B
"""update-tools: download and install CLI tools (Python port)

Behaviors:
- resolve GitHub release asset by regex (uses GH_TOKEN/GITHUB_TOKEN if set)
- resolve GitLab release asset by regex (uses GITLAB_TOKEN if set)
- download raw URLs
- extract tar.gz or zip archives, optionally a single member
- install binary to $HOME/.local/bin and set +x permission
"""

import argparse
import os
import re
import sys
import json
import stat
import shutil
import tempfile
import urllib.request
import urllib.error
import urllib.parse
import platform
import logging
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from functools import lru_cache
from typing import Callable


def get_arch_deb():
  mapping = {
    'x86_64': 'amd64',
    'aarch64': 'arm64',
  }
  return mapping[platform.machine().lower()]


def get_arch_aqua():
  mapping = {
    'x86_64': '64bit',
    'aarch64': 'ARM64',
  }
  return mapping[platform.machine().lower()]


def get_arch_tj():
  mapping = {
    'x86_64': 'x86_64',
    'aarch64': 'arm64',
  }
  return mapping[platform.machine().lower()]


logging.basicConfig(level=logging.INFO, format='%(message)s', stream=sys.stderr)
logger = logging.getLogger(__name__)

CHUNK_SIZE = 64 * 1024


def _format_size(num_bytes):
  size = float(num_bytes)
  for unit in ('B', 'KiB', 'MiB'):
    if size < 1024:
      return f"{size:.1f}{unit}"
    size /= 1024
  return f"{size:.1f}GiB"


class ProgressUI:
  """Owns progress/color state and renders download progress to stderr.

  Two rendering modes: an interactive, redrawn bar for a real terminal, and
  a plain append-only '#' bar for redirected/logged output (no \\r tricks,
  since there's no cursor to move). configure() picks one based on the
  environment; everything else just calls reporter(total).
  """

  WIDTH = 30
  RESET = "\033[0m"
  BOLD = "\033[1m"
  BAR_FULL = "\033[36m"   # cyan
  BAR_EMPTY = "\033[90m"  # gray
  SIZE_COLOR = "\033[32m"  # green

  def __init__(self):
    self.progress_enabled = True
    self.snake_enabled = False
    self.color_enabled = True

  def configure(self, quiet):
    is_tty = sys.stderr.isatty()
    self.progress_enabled = not quiet and is_tty
    self.snake_enabled = not quiet and not is_tty
    self.color_enabled = self.progress_enabled and not os.environ.get('NO_COLOR')

  def _colorize(self, text, code):
    return f"{code}{text}{self.RESET}" if self.color_enabled else text

  def _render_bar(self, downloaded, total):
    if total:
      frac = min(downloaded / total, 1.0)
      filled = int(self.WIDTH * frac)
      bar = (self._colorize('#' * filled, self.BAR_FULL)
             + self._colorize('-' * (self.WIDTH - filled), self.BAR_EMPTY))
      pct = self._colorize(f"{frac * 100:5.1f}%", self.BOLD)
      size = self._colorize(f"{_format_size(downloaded)}/{_format_size(total)}", self.SIZE_COLOR)
      line = f"\r\033[K[{bar}] {pct}  {size}"
    else:
      line = f"\r\033[K{self._colorize(_format_size(downloaded) + ' downloaded', self.SIZE_COLOR)}"
    sys.stderr.write(line)
    sys.stderr.flush()

  def _make_snake_updater(self, total):
    printed = 0

    def update(downloaded):
      nonlocal printed
      if not total:
        return
      target = int(self.WIDTH * min(downloaded / total, 1.0))
      if target > printed:
        sys.stderr.write('#' * (target - printed))
        sys.stderr.flush()
        printed = target

    return update

  @contextmanager
  def reporter(self, total):
    """Yields update(downloaded) callable; a no-op when progress is disabled."""
    if self.progress_enabled:
      try:
        yield lambda downloaded: self._render_bar(downloaded, total)
      finally:
        sys.stderr.write('\n')
        sys.stderr.flush()
      return

    if self.snake_enabled:
      try:
        yield self._make_snake_updater(total)
      finally:
        sys.stderr.write('\n')
        sys.stderr.flush()
      return

    yield lambda downloaded: None


ui = ProgressUI()


@lru_cache()
def fetch_url(url, headers = ()):
  req = urllib.request.Request(url)
  req.add_header('User-Agent', 'update-tools/1.0')
  for h,v in headers:
    req.add_header(h, v)

  with urllib.request.urlopen(req) as r:
    data = r.read().decode().strip()
  return data


def _match_asset(label, match, candidates):
  """candidates: iterable of (name, url) pairs. Logs and returns the first
  matching url, or logs an error and returns None."""
  for name, url in candidates:
    if name and url and re.search(r'^' + match + r'$', name):
      logger.info("==> resolved %s -> %s", label, url)
      return url

  logger.error("No matching asset found for %s (%s)", label, match)
  return None


def github_url(repo, match):
  logger.info("Resolving GitHub release asset for %s", repo)

  url = f"https://api.github.com/repos/{repo}/releases/latest"

  headers = (
    ('Accept', 'application/vnd.github+json'),
    ('X-GitHub-Api-Version', '2022-11-28'),
  )
  token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
  if token:
    headers += (("Authorization", f"Bearer {token}"),)

  data = json.loads(fetch_url(url, tuple(headers)))
  candidates = ((asset['name'], asset['browser_download_url']) for asset in data['assets'])
  return _match_asset(repo, match, candidates)


def gitlab_url(project, match):
  logger.info("Resolving GitLab release asset for %s", project)

  # permalink/latest (redirects to the actual release, followed transparently
  # by urlopen) mirrors GitHub's /releases/latest: it resolves to the newest
  # real release and skips upcoming/scheduled ones, unlike the plain
  # /releases list where an upcoming release can sort first.
  project_path = urllib.parse.quote(project, safe='')
  url = f"https://gitlab.com/api/v4/projects/{project_path}/releases/permalink/latest"

  headers = ()
  token = os.environ.get("GITLAB_TOKEN")
  if token:
    headers = (("PRIVATE-TOKEN", token),)

  release = json.loads(fetch_url(url, headers))
  links = (release.get('assets') or {}).get('links') or []
  candidates = ((link.get('name'), link.get('direct_asset_url')) for link in links)
  return _match_asset(project, match, candidates)


def download_to_temp(url, retries=3):
  logger.info("==> downloading %s", url)
  for attempt in range(1, retries+1):
    tf = tempfile.NamedTemporaryFile(delete=False)
    try:
      req = urllib.request.Request(url)
      with urllib.request.urlopen(req, timeout=30) as r:
        total = int(r.headers.get('Content-Length') or 0)
        downloaded = 0
        with ui.reporter(total) as report:
          while True:
            chunk = r.read(CHUNK_SIZE)
            if not chunk:
              break
            tf.write(chunk)
            downloaded += len(chunk)
            report(downloaded)
      tf.close()
      return tf.name
    except Exception as e:
      tf.close()
      Path(tf.name).unlink(missing_ok=True)
      if attempt == retries:
        raise
      logger.error("download failed (attempt %d/%d): %s", attempt, retries, e)
  raise RuntimeError("download failed")


def extract_tar(tar_path, cmd, bin_dir, archive_member=None):
  if not archive_member:
    archive_member = cmd
  import tarfile
  logger.info("==> tar: extracting %s to %s", cmd, bin_dir)
  with tarfile.open(tar_path, "r:gz") as tf:
    for m in tf.getmembers():
      if Path(m.name).name == archive_member and m.isfile():
        f = tf.extractfile(m)
        with open(bin_dir / cmd, 'wb') as out_f:
          shutil.copyfileobj(f, out_f)
  Path(tar_path).unlink()

def extract_zip(zip_path, cmd, bin_dir, archive_member=None):
  if not archive_member:
    archive_member = cmd
  import zipfile
  logger.info("==> zip: extracting %s to %s", cmd, bin_dir)
  with zipfile.ZipFile(zip_path) as zf:
    with zf.open(archive_member) as src, open(bin_dir / cmd, 'wb') as dst:
      shutil.copyfileobj(src, dst)
  Path(zip_path).unlink()


STATE_FILE = Path.home() / '.local' / 'state' / 'update-tools.json'


def _load_state():
  try:
    return json.loads(STATE_FILE.read_text())
  except (FileNotFoundError, json.JSONDecodeError):
    return {}


def _save_state(state):
  STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
  STATE_FILE.write_text(json.dumps(state, indent=2, sort_keys=True))


def install(cmd, url, archive_member=None):
  bin_dir = Path.home() / '.local' / 'bin'

  if url is None:
    raise RuntimeError(f"no download URL resolved for {cmd}")

  # The resolved URL embeds the version for essentially every tool here
  # (GitHub release assets and the version-lookup URLs both include it), so
  # comparing it is a good enough proxy for "is this the latest version"
  # without needing a per-tool `--version` parser.
  state = _load_state()
  if state.get(cmd) == url and (bin_dir / cmd).exists():
    logger.info("==> %s is up to date", cmd)
    return

  logger.info("Installing %s from %s", cmd, url)

  tmp = download_to_temp(url)

  decoded_url = urllib.parse.unquote(url)
  if decoded_url.endswith('.tar.gz') or decoded_url.endswith('.tgz'):
    extract_tar(tmp, cmd, bin_dir, archive_member)
  elif decoded_url.endswith('.zip'):
    extract_zip(tmp, cmd, bin_dir, archive_member)
  else:
    shutil.move(tmp, bin_dir / cmd)

  binary = Path(bin_dir / cmd)
  binary.chmod(binary.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
  binary.touch()

  state[cmd] = url
  _save_state(state)
  logger.info("==> installed %s", cmd)


@dataclass(frozen=True)
class Tool:
  installer: Callable[[], None]
  binaries: tuple[str, ...]  # binary names this tool puts in bin_dir


def build_registry() -> dict[str, Tool]:
  """Build a name -> Tool mapping. Installers are deferred (no network calls
  happen until invoked), so selecting a subset of tools does not trigger
  lookups for the ones left out. `binaries` records what each tool actually
  installs, which is more than one name for a bundle like "cfssl"."""
  registry: dict[str, Tool] = {}

  def add(name, installer, binaries=None):
    registry[name] = Tool(installer=installer, binaries=binaries or (name,))

  def add_bundle(name, binaries, resolve):
    """Bundle installer for tools that produce multiple binaries. `resolve(cmd)`
    returns the download URL for that binary — the same shared archive URL for
    every cmd (one archive with all binaries inside, keyed by name) or a URL
    computed per cmd for tools that publish one asset per binary."""
    def installer():
      for cmd in binaries:
        install(cmd, resolve(cmd))

    add(name, installer, binaries=binaries)

  age_binaries = ('age', 'age-keygen')
  add_bundle("age", age_binaries, lambda cmd: github_url('FiloSottile/age', r'age-v.*-linux-' + get_arch_deb() + r'\.tar\.gz'))

  add("bao", lambda: install("bao", github_url('openbao/openbao', r'openbao_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  cfssl_binaries = ('cfssl', 'cfssl-bundle', 'cfssl-certinfo', 'cfssl-newkey', 'cfssl-scan', 'cfssljson', 'mkbundle', 'multirootca')
  add_bundle("cfssl", cfssl_binaries, lambda cmd: github_url('cloudflare/cfssl', cmd + r'_.*_linux_' + get_arch_deb()))

  add("dockle", lambda: install("dockle", github_url('goodwithtech/dockle', r'dockle_.*_Linux-' + get_arch_aqua() + r'\.tar\.gz')))

  add("etcdctl", lambda: install("etcdctl", github_url('etcd-io/etcd', r'etcd-v.*-linux-' + get_arch_deb() + r'\.tar\.gz')))

  add("gh", lambda: install("gh", github_url('cli/cli', r'gh_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("glab", lambda: install("glab", gitlab_url('gitlab-org/cli', r'glab_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("grype", lambda: install("grype", github_url('anchore/grype', r'grype_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("hadolint", lambda: install("hadolint", github_url('hadolint/hadolint', r'hadolint-linux-' + get_arch_tj())))

  add("helm", lambda: install("helm", 'https://get.helm.sh/helm-' + fetch_url('https://get.helm.sh/helm4-latest-version') + '-linux-' + get_arch_deb() + '.tar.gz'))

  add("jq", lambda: install("jq", github_url('stedolan/jq', r'jq-linux-' + get_arch_deb())))

  add("k6", lambda: install("k6", github_url('grafana/k6', r'k6-v.*-linux-' + get_arch_deb() + r'\.tar\.gz')))

  add("k9s", lambda: install("k9s", github_url('derailed/k9s', r'k9s_Linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("kubectl", lambda: install("kubectl", 'https://storage.googleapis.com/kubernetes-release/release/' + fetch_url('https://storage.googleapis.com/kubernetes-release/release/stable.txt') + '/bin/linux/' + get_arch_deb() + '/kubectl'))

  add("lego", lambda: install("lego", github_url('go-acme/lego', r'lego_v.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("logcli", lambda: install("logcli", github_url('grafana/loki', r'logcli-linux-' + get_arch_deb() + r'\.zip'), "logcli-linux-" + get_arch_deb()))

  # upstream minio/mc was archived 2026-07-14; pgsty/mc is the community fork,
  # renamed to "mcli" to avoid trading on MinIO's trademark
  add("mcli", lambda: install("mcli", github_url('pgsty/mc', r'mcli_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("talosctl", lambda: install("talosctl", github_url('siderolabs/talos', r'talosctl-linux-' + get_arch_deb())))

  add("tofu", lambda: install("tofu", github_url('opentofu/opentofu', r'tofu_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("repo-security-scanner", lambda: install("repo-security-scanner", github_url('techjacker/repo-security-scanner', r'repo-security-scanner_.*_Linux_' + get_arch_tj() + r'\.tar\.gz')))

  add("sops", lambda: install("sops", github_url('getsops/sops', r'sops-v.*\.linux\.' + get_arch_deb())))

  add("syft", lambda: install("syft", github_url('anchore/syft', r'syft_.*_linux_' + get_arch_deb() + r'\.tar\.gz')))

  add("trivy", lambda: install("trivy", github_url('aquasecurity/trivy', r'trivy_.*_Linux-' + get_arch_aqua() + r'\.tar\.gz')))

  add("yq", lambda: install("yq", github_url('mikefarah/yq', r'yq_linux_' + get_arch_deb())))

  return registry


def known_binaries(registry: dict[str, Tool]):
  """Every binary name build_registry() can currently produce."""
  binaries = set()
  for tool in registry.values():
    binaries.update(tool.binaries)
  return binaries


def prune_removed_tools(registry: dict[str, Tool]):
  """Remove binaries (and their state entries) that a previous run installed
  but that no longer belong to any tool in the registry, e.g. after a tool
  was dropped from build_registry()."""
  state = _load_state()
  managed = known_binaries(registry)
  bin_dir = Path.home() / '.local' / 'bin'

  stale = [name for name in state if name not in managed]
  for name in stale:
    binary = bin_dir / name
    if binary.exists():
      binary.unlink()
      logger.info("==> removed %s (no longer in update-tools)", name)
    del state[name]

  if stale:
    _save_state(state)


def parse_args(argv=None) -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description="Download and install CLI tools to ~/.local/bin",
  )
  parser.add_argument(
    "tools",
    nargs="*",
    metavar="TOOL",
    help="Tool(s) to update",
  )
  parser.add_argument(
    "--all",
    action="store_true",
    help="Update all known tools",
  )
  parser.add_argument(
    "-q", "--quiet",
    action="store_true",
    help="Suppress progress bars and info logs; only show errors",
  )
  args = parser.parse_args(argv)

  if args.all and args.tools:
    parser.error("cannot combine --all with specific TOOL arguments")
  if not args.all and not args.tools:
    parser.error("specify one or more TOOL names, or use --all to update everything")

  return args


EXIT_OK = 0
EXIT_FAILED = 1   # ran fine, but one or more tools failed to update
EXIT_USAGE = 2    # bad arguments (matches argparse's own parser.error() exit code)


def main(argv=None):
  args = parse_args(argv)

  ui.configure(quiet=args.quiet)
  if args.quiet:
    logger.setLevel(logging.ERROR)

  registry = build_registry()
  prune_removed_tools(registry)

  if args.all:
    selected = list(registry)
  else:
    selected = list(dict.fromkeys(args.tools))
    unknown = [name for name in selected if name not in registry]
    if unknown:
      logger.error("Unknown tool(s): %s", ", ".join(unknown))
      logger.error("Available tools: %s", ", ".join(sorted(registry)))
      sys.exit(EXIT_USAGE)

  failed = []
  for name in selected:
    try:
      registry[name].installer()
    except Exception as e:
      logger.error("==> failed to update %s: %s", name, e)
      failed.append(name)

  if failed:
    logger.error("Did not update: %s", ", ".join(failed))
    sys.exit(EXIT_FAILED)


if __name__ == '__main__':
  main()
